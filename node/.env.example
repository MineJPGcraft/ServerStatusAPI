# ============================================================
# 节点端环境变量配置
# 复制此文件为 .env 并修改对应的值
# ============================================================

# ---------- 必填项 ----------

# 服务端地址
SERVER_URL=http://localhost:8000

# 节点设备ID（需与服务端 config.yaml 中 registered_nodes 的 id 一致）
DEVICE_ID=node-001

# 节点Token（需与服务端 config.yaml 中 registered_nodes 的 token 一致）
TOKEN=change-me-please

# ---------- 可选项（覆盖服务端下发的配置，优先级最高） ----------
# 如果不设置这些环境变量，节点将使用服务端下发的配置值
# 设置后，对应的值将覆盖服务端的配置（包括 node_defaults 和节点单独配置）

# 监测间隔（秒）：节点每隔多久检测一次MC服务器
# MONITOR_INTERVAL=15

# 上报间隔（秒）：节点每隔多久向服务端上报数据
# REPORT_INTERVAL=30

# 配置刷新间隔（秒）：节点每隔多久重新拉取配置
# CONFIG_REFRESH_INTERVAL=120

# ---------- 可选项（性能调优） ----------
# 这些参数控制节点端监测大量服务器时的并发行为
# 不设置时使用默认值，通常无需修改

# 最大并发检测数：同时最多检测多少台服务器
# 默认50，服务器数量少时可调低，数量多时可调高
# MAX_CONCURRENCY=50

# 单台服务器状态查询超时（秒）：超过此时间视为离线
# 默认15秒，网络条件差时可适当调高
# 注意：DNS解析有独立的30秒超时，不占用此时间
# SERVER_TIMEOUT=15

# 离线服务器退避倍数：离线服务器的检测间隔 = monitor_interval × 此倍数
# 默认3，即离线服务器每3轮才检测1次，减少对已知离线服务器的无效请求
# 设为1则禁用退避（所有服务器每轮都检测）
# OFFLINE_BACKOFF=3

# 线程池大小：mcstatus 同步调用的线程池容量
# 默认 = MAX_CONCURRENCY × 4（自动计算）
# 超时的线程无法被杀死会继续占用线程，需要足够冗余防止级联耗尽
# THREAD_POOL_SIZE=200
