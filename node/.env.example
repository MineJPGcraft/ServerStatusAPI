# ============================================================
# 节点端环境变量配置
# 复制此文件为 .env 并修改对应的值
# ============================================================

# ---------- 必填项 ----------

# 服务端地址
SERVER_URL=http://localhost:8000

# 节点设备ID（需与服务端 config.yaml 中 registered_nodes 的 id 一致）
DEVICE_ID=node-001

# 节点Token（需与服务端 config.yaml 中 registered_nodes 的 token 一致）
TOKEN=change-me-please

# ---------- 可选（覆盖服务端配置，优先级最高） ----------

# 监测间隔（秒）
# MONITOR_INTERVAL=15

# 上报间隔（秒）
# REPORT_INTERVAL=30

# 配置刷新间隔（秒）
# CONFIG_REFRESH_INTERVAL=120

# ---------- 可选（性能调优） ----------

# 最大并发检测数：同时最多检测多少台服务器
# 默认50
# MAX_CONCURRENCY=50

# 单台服务器超时（秒）：DNS解析+状态查询的各自超时
# 默认15秒
# SERVER_TIMEOUT=15

# 离线服务器退避倍数：离线服务器的检测间隔 = monitor_interval × 此倍数
# 默认3，设为1则禁用退避
# OFFLINE_BACKOFF=3
